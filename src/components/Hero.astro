---
import { Image } from 'astro:assets';
import avatar1 from '../assets/avatar-1.png';
import avatar2 from '../assets/avatar-2.png';
import avatar3 from '../assets/avatar-3.png';
import avatar4 from '../assets/avatar-4.png';
---

<section class="hero" id="hero">
  <video class="hero-bg-video" autoplay muted loop playsinline>
    <source src="/assets/hero-background.mov" type="video/mp4" />
  </video>

  <div class="hero-content">
    <div class="social-proof">
      <div class="avatars">
        <Image class="avatar" src={avatar1} width={28} height={28} alt="Client avatar 1" loading="eager" fetchpriority="high" />
        <Image class="avatar" src={avatar2} width={28} height={28} alt="Client avatar 2" loading="eager" fetchpriority="high" />
        <Image class="avatar" src={avatar3} width={28} height={28} alt="Client avatar 3" loading="eager" fetchpriority="high" />
        <Image class="avatar" src={avatar4} width={28} height={28} alt="Client avatar 4" loading="eager" fetchpriority="high" />
      </div>

      <p class="social-proof__text" data-i18n-html="hero.socialProof">
        Junte-se a outros <strong>mais de <span class="social-proof__count" data-count-start="72894" data-count-end="91425">91.425</span> lojistas</strong> que usam a Shopify.
      </p>
    </div>

    <h1 class="hero-headline">
      <span class="hero-headline-desktop">
        <span class="hero-headline__first" data-i18n="hero.headline1">Eleve o seu eCommerce</span>
        <span class="hero-headline__second">
          <span class="hero-logo-icon" role="img" aria-label="Flamma"></span>
          <span data-i18n="hero.headline2">para o próximo level.</span>
        </span>
      </span>

      <span class="hero-headline-mobile">
        <span data-i18n="hero.mobileLine1">Eleve o seu</span>
        <span data-i18n="hero.mobileLine2">eCommerce ao</span>
        <span class="hero-headline-mobile__last-line">
          <span class="hero-logo-icon" role="img" aria-label="Flamma"></span>
          <span data-i18n="hero.mobileLine3">próximo nível.</span>
        </span>
      </span>
    </h1>

    <p class="hero-subtext" data-i18n="hero.subtext">
      Transforme o seu negócio local em uma verdadeira máquina de vendas e performance, impulsionada pela tecnologia Shopify.
    </p>
  </div>

  <div class="hero-scroll-indicator" aria-hidden="true">
    <div class="scroll-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="48" fill="currentColor" viewBox="0 0 256 256">
        <path d="M144,16H112A64.07,64.07,0,0,0,48,80v96a64.07,64.07,0,0,0,64,64h32a64.07,64.07,0,0,0,64-64V80A64.07,64.07,0,0,0,144,16Zm48,160a48.05,48.05,0,0,1-48,48H112a48.05,48.05,0,0,1-48-48V80a48.05,48.05,0,0,1,48-48h32a48.05,48.05,0,0,1,48,48ZM136,83.31v89.38l10.34-10.35a8,8,0,0,1,11.32,11.32l-24,24a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L120,172.69V83.31L109.66,93.66A8,8,0,0,1,98.34,82.34l24-24a8,8,0,0,1,11.32,0l24,24a8,8,0,0,1-11.32,11.32Z"/>
      </svg>
    </div>
  </div>
</section>