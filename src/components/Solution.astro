import { Image } from 'astro:assets';
import solutionImage from '../assets/solution-image.png';
---

<section class="solution" id="solution">
        <div class="solution-content">
            <div class="solution-copy">
                <span class="feature-badge solution-badge">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 256 256"><path d="M229.26,90.4a108,108,0,0,1-177.63,114A108,108,0,0,1,195.41,43.63l20.1-20.11a12,12,0,0,1,17,17l-96,96a12,12,0,1,1-17-17l24-24a36,36,0,1,0,19.76,39.65,12,12,0,0,1,23.53,4.74,60,60,0,1,1-25.73-62L178.3,60.74a84,84,0,1,0,28.46,38,12,12,0,1,1,22.5-8.35Z"></path></svg>
                    <span data-i18n="solution.badge">Melhores soluções</span>
                </span>

                <h2 class="solution-title">
                    <span data-i18n="solution.titleLine1">Porque escolher</span>
                    <span class="solution-title-line2">
                        <span data-i18n="solution.titleLine2">a Shopify</span>
