---
import "../styles/global.css";

const {
  title = "Flamma Digital | Shopify Agency",
  description = "Transforme o seu negócio com soluções Shopify da Flamma Digital.",
  lang = "pt-BR",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title data-i18n="meta.title">{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/assets/flamma-favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Work+Sans:wght@500&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/flag-icons@7.2.3/css/flag-icons.min.css"
    />
  </head>
  <body>
    <div class="site-noise" aria-hidden="true"></div>
    <slot />
  </body>
</html>
